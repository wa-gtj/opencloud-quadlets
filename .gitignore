.idea
# exclude the .env file which will be created from env.example
/opencloud-stack-common/.env

# exclude the apps folder
/opencloud-stack-common/config/opencloud/apps/*
!/opencloud-stack-common/config/opencloud/apps/.gitkeep
!/opencloud-stack-common/config/opencloud/apps/maps

# exclude *-custom.container.d pull-ins
/*-custom.container.d/*

# exclude certificates
/opencloud-stack-common/certs/*
!/opencloud-stack-common/certs/.gitkeep

# exclude the certificates config folder
/opencloud-stack-common/config/traefik/dynamic/*
!/opencloud-stack-common/config/traefik/dynamic/.gitkeep
