[Unit]
Description=Traefik Container for Opencloud stack

[Container]
# Container
ContainerName=traefik
Image=docker.io/library/traefik:v3.7.19
Entrypoint=["/bin/sh", "/opt/traefik/bin/docker-entrypoint-override.sh"]
#Exec=

# User
#User=
LogDriver=${LOG_DRIVER}

# Volumes
Volume=${DOCKER_SOCKET_PATH}:/var/run/docker.sock:ro
Volume=%h/.config/containers/systremd/config/traefik/docker-entrypoint-override.sh:/opt/traefik/bin/docker-entrypoint-override.sh
Volume=${TRAEFIK_CERTS_DIR}:/certs
Volume=%h/.config/containers/systemd/config/traefik/dynamic:/etc/traefik/dynamic:z

# Network
Network=opencloud-net
NetworkAlias=${OC_DOMAIN}
PublishPort=${TRAEFIK_PORT_HTTP}:${TRAEFIK_PORT_HTTP}
PublishPort=${TRAEFIK_PORT_HTTPS}:${TRAEFIK_PORT_HTTPS}

# Environment
Environment=TRAEFIK_SERVICES_TLS_CONFIG=${TRAEFIK_SERVICES_TLS_CONFIG}
Environment=TRAEFIK_ACME_MAIL=${TRAEFIK_ACME_MAIL}
Environment=TRAEFIK_ACME_CASERVER=${TRAEFIK_ACME_CASERVER}
Environment=TRAEFIK_LOG_LEVEL=${TRAEFIK_LOG_LEVEL}
Environment=TRAEFIK_ACCESS_LOG=${TRAEFIK_ACCESS_LOG}
Environment=TRAEFIK_PORT_HTTP=${TRAEFIK_PORT_HTTP}
Environment=TRAEFIK_PORT_HTTPS=${TRAEFIK_PORT_HTTPS}

# Labels
Label=traefik.enable=${TRAEFIK_DASHBOARD}
# defaults to admin:admin
Label=traefik.http.middlewares.traefik-auth.basicauth.users=${TRAEFIK_BASIC_AUTH_USERS}
Label=traefik.http.routers.traefik.entrypoints=https
Label=traefik.http.routers.traefik.rule=Host(`${TRAEFIK_DOMAIN}`)
Label=traefik.http.routers.traefik.middlewares=traefik-auth
Label=traefik.http.routers.traefik.${TRAEFIK_SERVICES_TLS_CONFIG}
Label=traefik.http.routers.traefik.service=api@internal

[Service]
EnvironmentFile=%h/.config/containers/systemd/opencloud-stack-common/opencloud_defaults.env
EnvironmentFile=-%h/.config/containers/systemd/opencloud-stack-common/opencloud_overrides.env

Restart=always
TimeOutStartSec=900

[Install]
